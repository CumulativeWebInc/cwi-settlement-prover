{"$id":"https://cumulativewebinc.github.io/cwi-settlement-prover/schema/proofs.schema.json","$schema":"http://json-schema.org/draft-07/schema#","description":"Machine-readable on-chain settlement verification. cwi.settlement-proof/1.0 — for agents proving an agent-to-agent payment actually settled.","properties":{"checks":{"items":{"properties":{"actual":{"type":"string"},"expected":{"type":"string"},"id":{"type":"string"},"label":{"type":"string"},"note":{"type":"string"},"result":{"enum":["pass","fail","unknown"]}},"required":["id","label","result"],"type":"object"},"type":"array"},"claim":{"properties":{"chain":{"enum":["base","ethereum"]},"expectedAmountWei":{"pattern":"^[0-9]+$","type":"string"},"expectedTo":{"pattern":"^0x[0-9a-fA-F]{40}$","type":"string"},"hash":{"pattern":"^0x[0-9a-f]{64}$","type":"string"},"memo":{"type":"string"}},"required":["chain","hash"],"type":"object"},"errors":{"items":{"type":"string"},"type":"array"},"explorerUrl":{"type":["string","null"]},"finality":{"properties":{"assessment":{"enum":["low","medium","high","unknown"]},"confirmations":{"type":"number"},"note":{"type":"string"}},"type":["object","null"]},"mismatchedFields":{"items":{"type":"string"},"type":"array"},"observedAt":{"format":"date-time","type":"string"},"schema":{"const":"cwi.settlement-proof/1.0"},"verdict":{"enum":["SETTLED","PENDING","FAILED","NOT_FOUND","MISMATCH","RATE_LIMITED","INVALID_CLAIM","UNSUPPORTED"]}},"required":["schema","claim","observedAt","verdict","checks"],"title":"CWI Settlement Proof","type":"object"}